# Copy to infra/signet/.env and fill in. The real .env is gitignored.
#
# Cloudflare named-tunnel token for the `cloudflared` service. To get it:
#   Cloudflare dashboard -> Zero Trust -> Networks -> Tunnels -> Create a tunnel
#   (type: Cloudflared) -> name it (e.g. colorex-broker) -> copy the token.
# Then add a Public Hostname on that tunnel:
#   rfq-signet.colorex.io  ->  Service: HTTP  ->  broker:3000
# ("broker" is the compose service name; cloudflared reaches it over the network.)
CLOUDFLARE_TUNNEL_TOKEN=
